[Script]
# > AutoCAD解锁Pro
AutoCAD解锁Pro = type=http-response, pattern=^https:\/\/app\.autocad360\.com\/entitlements\/v2\/me\/status, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/AutoCAD/JS/AutoCAD.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% app.autocad360.com
