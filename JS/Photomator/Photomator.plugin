[Script]
# > Photomator-照片编辑解锁订阅
http-response ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Photomator/JS/JS-1/Photomator.js, requires-body=true, timeout=60, tag=Photomator
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Photomator/JS/JS-1/Photomator.js, timeout=60, tag=Photomator

[MITM]
hostname = api.revenuecat.com
