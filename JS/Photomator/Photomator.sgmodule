#!openUrl=https://apps.apple.com/app/id1444636541

[Script]
# > Photomator-照片编辑
Photomator = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Photomator/JS/JS-1/Photomator.js, requires-body=true, max-size=-1, timeout=60
Photomator = type=http-request, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Photomator/JS/JS-1/Photomator.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
