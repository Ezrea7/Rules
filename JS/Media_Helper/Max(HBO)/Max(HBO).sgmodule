#!name=Max(HBO) iOS 外挂字幕和强制1080p插件
#!desc=Max(HBO) iOS 外挂字幕和强制1080p插件
#!date=2025-12-18
#!category=🐹 BOBO Premium
#!author=liunice[https://github.com/liunice]


[Script]
# Max(HBO)外挂srt字幕
Max(HBO)外挂srt字幕 = type=http-response, pattern=^https:\/\/default\.prd\.api\.discomax\.com\/cms\/routes\/video\/watch\/.*?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Max(HBO)/JS/Max(HBO).js, requires-body=true, max-size=-1, timeout=60
Max(HBO)外挂srt字幕 = type=http-response, pattern=^https:\/\/cf\.prod\.media\.h264\.io\/r\/hlsMedia\.m3u8\?r\.host=.*?_(a|v|t)\d+\.m3u8&, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Max(HBO)/JS/Max(HBO).js, requires-body=true, max-size=-1, timeout=60
Max(HBO)外挂srt字幕 = type=http-response, pattern=^https:\/\/cf\.prod\.media\.h264\.io\/subtitles\/.*?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Max(HBO)/JS/Max(HBO).js, requires-body=true, max-size=-1, timeout=60
Max(HBO)外挂srt字幕 = type=http-response, pattern=^https:\/\/default\.prd\.api\.discomax\.com\/playback-orchestrator\/any\/playback-orchestrator\/v\d+\/playbackInfo$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Max(HBO)/JS/Max(HBO).js, requires-body=true, max-size=-1, timeout=60

# Max(HBO)强制1080p
Max(HBO)强制1080p = type=http-response, pattern=^https:\/\/cf\.(prod|prd)\.media\.h264\.io\/r\/hls\.m3u8\?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Max(HBO)/JS/Max(HBO).js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% default.prd.api.discomax.com, cf.prod.media.h264.io, cf.prd.media.h264.io
