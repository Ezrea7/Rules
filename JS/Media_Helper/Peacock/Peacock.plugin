#!name=Peacock iOS 去广告、强制1080p和外挂字幕插件
#!desc=Peacock iOS 去广告、强制1080p和外挂字幕插件
#!date=2025-12-18
#!category=🐹 Ezrea7 Premium
#!author=liunice[https://github.com/liunice]

[Rewrite]
# Peacock去广告
^https:\/\/.*?\.mediatailor\..*?\.amazonaws\.com\/v\d+\/tracking\/\w+\/peacock\-cmaf\-hls\-vod reject

[Script]
# Peacock去广告
http-response ^https:\/\/.*?\.mediatailor\..*?\.amazonaws\.com\/v\d+\/manifest\/\w+\/peacock\-cmaf\-hls\-vod.*?\/\d+\.m3u8 script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/Peacock/JS/Peacock.js, requires-body=true, timeout=60, tag=Peacock去广告

# Peacock外挂srt字幕
http-response ^https:\/\/atom\.peacocktv\.com\/adapter\-calypso\/v\d+\/query\/node/.*?\?represent=\(next script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/Peacock/JS/Peacock.js, requires-body=true, timeout=60, tag=Peacock外挂srt字幕
http-response ^https:\/\/.*?\.cdn\.peacocktv\.com\/.*?\.webvtt$ script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/Peacock/JS/Peacock.js, requires-body=true, timeout=60, tag=Peacock外挂srt字幕

# Peacock强制1080p
http-response ^https:\/\/.*?\.cdn\.peacocktv\.com\/.*?\/master_cmaf\.m3u8 script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/Peacock/JS/Peacock.js, requires-body=true, timeout=60, tag=Peacock强制1080p

[MITM]
hostname = *.peacocktv.com, *.mediatailor.*.amazonaw.com
