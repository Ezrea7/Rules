#!name=STARZ/Lionsgate+ iOS 外挂字幕和强制1080p插件
#!desc=STARZ/Lionsgate+ iOS 外挂字幕和强制1080p插件
#!date=2025-12-18
#!category=🐹 Ezrea7 Premium
#!author=liunice[https://github.com/liunice]


[Script]
# STARZ外挂srt字幕
STARZ外挂srt字幕 = type=http-response, pattern=^https:\/\/playdata\.starz\.com\/metadata-service\/play\/.*?\/content\?contentIds=, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/STARZ/JS/STARZ.js, requires-body=true, max-size=-1, timeout=60
STARZ外挂srt字幕 = type=http-response, pattern=^https:\/\/auth(-ios)?\.starz\.com\/api\/v\d+\/play\/start$, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/STARZ/JS/STARZ.js, requires-body=true, max-size=-1, timeout=60
STARZ外挂srt字幕 = type=http-response, pattern=^https:\/\/.*?\.starz\.com\/assets\/.*?.vtt$, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/STARZ/JS/STARZ.js, requires-body=true, max-size=-1, timeout=60

# STARZ强制1080p
STARZ强制1080p = type=http-response, pattern=^https:\/\/.*?\.starz\.com\/assets\/.*?\/Apple\/(spgb|dezmund|spfr)_.*?\.m3u8$, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Media_Helper/STARZ/JS/STARZ.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.starz.com
