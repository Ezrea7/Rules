[Script]
# HBO Max外挂srt字幕
http-response ^https:\/\/comet.*\.api\.hbo\.com\/express-content\/urn:hbo:page:[\w\-]+:type:series\? script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max外挂srt字幕
http-request ^https:\/\/comet.*\.api\.hbo\.com\/content$ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max外挂srt字幕
http-response ^https:\/\/comet.*\.api\.hbo\.com\/content$ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max外挂srt字幕
http-response ^https:\/\/manifests\.api\.hbo\.com\/hlsMedia\.m3u8\?r\.host=.*?(t|a|v)\d+\.m3u8&r\.origin=cmaf script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max外挂srt字幕
http-response ^https:\/\/manifests\.api\.hbo\.com\/subtitles\/dummy\.vtt$ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max外挂srt字幕

# HBO Max强制1080p
http-response ^https:\/\/manifests\.api\.hbo\.com\/hls\.m3u8\?f\.audioTrack=.*?&r.origin=cmaf script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/HBOMax/JS/HBOMax.js, requires-body=true, timeout=60, tag=HBO Max强制1080p

[MITM]
hostname = manifests.api.hbo.com, comet*.api.hbo.com
