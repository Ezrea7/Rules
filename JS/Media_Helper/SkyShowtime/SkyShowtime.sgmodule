#!name=SkyShowtime iOS 界面全英文化、外挂字幕和强制1080p插件
#!desc=SkyShowtime iOS 界面全英文化、外挂字幕和强制1080p插件
#!date=2025-12-18
#!category=🐹 BOBO Premium
#!author=liunice[https://github.com/liunice]


[Script]
# SkyShowtime外挂srt字幕
SkyShowtime外挂srt字幕 = type=http-response, pattern=^https:\/\/atom\.skyshowtime\.com\/adapter\-calypso\/v\d+\/query\/node/.*?\?represent=\(next, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, requires-body=true, max-size=-1, timeout=60
SkyShowtime外挂srt字幕 = type=http-response, pattern=^https:\/\/.*?\.pcdn\d+\.cssott\.com\/SST\/.*?\.webvtt$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, requires-body=true, max-size=-1, timeout=60

# SkyShowtime强制1080p
SkyShowtime强制1080p = type=http-response, pattern=^https:\/\/.*?\.pcdn\d+\.cssott\.com\/SST\/.*?\/mpeg_cbcs\/master_manifest_.*?\.m3u8, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, requires-body=true, max-size=-1, timeout=60

# SkyShowtime界面全英文
SkyShowtime界面全英文 = type=http-response, pattern=^https:\/\/ovp\.skyshowtime\.com\/ls\/localisation$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, requires-body=true, max-size=-1, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/atom\.skyshowtime\.com\/adapter\-calypso\/v\d+\/query\/node/.*?\?represent=\(items\), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/atom\.skyshowtime\.com\/adapter\-calypso\/v\d+\/query\/menu$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/atom\.skyshowtime\.com\/adapter\-calypso\/v\d+\/labels$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/mobile\.clients\.skyshowtime\.com\/bff\/sections\/v\d+\/personalised\?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/mobile\.clients\.skyshowtime\.com\/bff\/sections\/v\d+\?template=sections&, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60
SkyShowtime界面全英文 = type=http-request, pattern=^https:\/\/atom\.skyshowtime\.com\/adapter\-calypso\/v\d+\/query\/node\/(provider_series_id|provider_variant_id)\/, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/SkyShowtime/JS/SkyShowtime.js, timeout=60

[MITM]
hostname = %APPEND% ovp.skyshowtime.com, atom.skyshowtime.com, *.pcdn*.cssott.com, mobile.clients.skyshowtime.com
