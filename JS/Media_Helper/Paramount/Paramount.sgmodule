#!name=Paramount+ iOS 外挂字幕和强制1080p插件
#!desc=Paramount+ iOS 外挂字幕和强制1080p插件
#!date=2025-12-18
#!category=🐹 Ezrea7 Premium
#!author=liunice[https://github.com/liunice]


[Script]
# Paramount+外挂srt字幕
Paramount+外挂srt字幕 = type=http-response, pattern=^https:\/\/link\.theplatform\.com\/s\/\w+\/\w+\?format=SMIL, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Paramount/JS/Paramount.js, requires-body=true, max-size=-1, timeout=60
Paramount+外挂srt字幕 = type=http-response, pattern=^https:\/\/pubads\.g\.doubleclick\.net\/ondemand\/hls\/content\/.*?\/\d+\-\d+\.vtt$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Paramount/JS/Paramount.js, requires-body=true, max-size=-1, timeout=60
Paramount+外挂srt字幕 = type=http-response, pattern=^https:\/\/vod\-.*?\.cbsaavideo\.com\/intl_vms\/.*?\/seg_\d+\.vtt$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Paramount/JS/Paramount.js, requires-body=true, max-size=-1, timeout=60

# Paramount+强制1080p
Paramount+强制1080p = type=http-response, pattern=^https:\/\/vod.*?\.cbsaavideo\.com\/intl_vms\/.*?\/master\.m3u8, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Paramount/JS/Paramount.js, requires-body=true, max-size=-1, timeout=60

# Paramount+禁用强制更新
Paramount+禁用强制更新 = type=http-response, pattern=^https:\/\/www\.paramountplus\.com\/apps\-api\/v\d+\.\d+\/\w+\/app\/status\.json\?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Media_Helper/Paramount/JS/Paramount.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% pubads.g.doubleclick.net, link.theplatform.com, vod*.cbsaavideo.com, www.paramountplus.com
