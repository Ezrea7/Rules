[Script]
# > Nicegram会员解锁
Nicegram会员解锁 = type=http-response, pattern=^https?:\/\/nicegram\.cloud\/api\/v\d+\/(telegram\/auth|att\/scroll-to-earn\/(?:config|ads-list|user-info)|airdrop\/task-list|ai-assistant\/list|user\/info|unblock-feature), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Nicegram/JS/Nicegram.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% nicegram.cloud
