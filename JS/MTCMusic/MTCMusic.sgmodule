#!openUrl=https://apps.apple.com/app/id1062550132

[Script]
# > MTC Music-解锁VIP
MTC Music解锁VIP = type=http-response, pattern=^https:\/\/api\.music\.yandex\.net\/account\/mts\/status, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/MTCMusic/JS/MTCMusic.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.music.yandex.net

