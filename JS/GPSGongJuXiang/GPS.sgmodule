[Script]
# > GPS工具箱解锁VIP
GPS工具箱解锁VIP = type=http-response, pattern=^https:\/\/service\.gpstool\.com\/app\/index\/getUserInfo, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/GPSGongJuXiang/JS/GPS.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% service.gpstool.com
