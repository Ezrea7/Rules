[Script]
# > 蛋啵解锁VIP功能
http-response ^https://api-sub\.meitu\.com/v2/user/vip_info_by_group script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/DanBo/JS/danbovip.js, requires-body=true, timeout=60, tag=蛋啵VIP
http-response ^https://ai\.xiuxiu\.meitu\.com/v1/tool/mtlab/ai_graffiti_permission script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/DanBo/JS/danboai.js, requires-body=true, timeout=60, tag=蛋啵VIP

[MITM]
hostname = ai.xiuxiu.meitu.com, api-sub.meitu.com
