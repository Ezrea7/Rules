[Script]
# > Loopsie AI绘画-解锁订阅
Loopsie = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Loopsie/JS/Loopsie.js, requires-body=true, max-size=-1, timeout=60
Loopsie = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Loopsie/JS/Loopsie.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
