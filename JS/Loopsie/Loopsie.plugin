[Script]
# > Loopsie AI绘画-解锁订阅
http-response ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Loopsie/JS/Loopsie.js, requires-body=true, timeout=60, tag=Loopsie
http-request ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Loopsie/JS/Loopsie.js, timeout=60, tag=Loopsie

[MITM]
hostname = api.revenuecat.com
