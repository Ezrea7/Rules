#!name=功能插件｜解除微信链接限制
#!desc=跳过中间界面，被封禁链接进行通知弹窗跳转
#!date=2026-01-21
#!category=🐹 Ezrea7 Enhance
#!author=zZPiglet[https://github.com/zZPiglet]

[Script]
# > 解除微信链接限制
http-response ^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\? script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/WeChat/JS/UnblockURLinWeChat.js, requires-body=true, tag=解除微信链接限制

[MITM]
hostname = security.wechat.com, weixin110.qq.com
