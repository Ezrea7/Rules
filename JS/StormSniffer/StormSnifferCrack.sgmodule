#!name=解锁StormSniffer
#!desc=解锁Storm Sniffer
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=浥轻尘yqc007[https://github.com/yqc007/QuantumultX]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/StormSniffer.png
#!openUrl=https://apps.apple.com/app/id1610958307

[Script]
# > 解锁StormSniffer
StormSnifferHeader = type=http-request, pattern="^http[s]?:\/\/api\.x-storm\.com(:\d{2,5})?\/app/.+$", script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/StormSniffer/JS/StormSnifferHeader.js, timeout=60, script-update-interval=0
StormSnifferCrack = type=http-response, pattern="^http[s]?:\/\/api\.x-storm\.com(:\d{2,5})?\/app/user-profile\/$", requires-body=true, max-size=3145728, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/StormSniffer/JS/StormSnifferCrack.js, timeout=60, script-update-interval=0

[MITM]
hostname = %APPEND% *.x-storm.com
