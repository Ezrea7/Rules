[Script]
# > 书旗小说-会员中心
书旗小说-会员中心 = type=http-response, pattern=^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/ShuQi/JS/ShuQi.js, requires-body=true, max-size=-1, timeout=60
# > 书旗小说-用户中心
书旗小说-用户中心 = type=http-request, pattern=^https:\/\/ocean\.shuqireader\.com\/api\/jspend\/iosapi\/userinfo\/info, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/ShuQi/JS/ShuQi.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% ocean.shuqireader.com
