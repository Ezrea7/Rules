#!name=JavDB跳转MissAV
#!desc=去除JavDB网页广告，视频详情页点击clickPlay即可跳转MissAV看瑟瑟，或者视频详情页点击直接Google搜索，另外全面去除MISSAV网页的广告，包括首次点击播放的广告跳转
#!date=2025-12-19
#!category=🐹 Ezrea7 Premium
#!author=limbopro[https://github.com/limbopro/Adblock4limbo],墨鱼ddgksf2013[https://github.com/ddgksf2013]
#!openUrl=https://javdb.com/

[Rule]
DOMAIN-SUFFIX,mc.yandex.ru,REJECT
DOMAIN-SUFFIX,static.cloudflareinsights.com,REJECT

[Script]
# > JavDB去广告
JavDB = type=http-response,pattern=^https?:\/\/javdb\.com\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))),requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/JavDB/JS/JavDB.ad.js

# > MissAV去广告
MissAv = type=http-response,pattern=^https?:\/\/missav\.(ws|live|com|ai)\/(?!(.*(api|login|cdn-cgi|verify|auth|captch|(\.(js|css|jpg|jpeg|png|webp|gif|zip|woff|woff2|m3u8|mp4|mov|m4v|avi|mkv|flv|rmvb|wmv|rm|asf|asx|mp3|json|ico|otf|ttf))))),requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/JavDB/JS/MissAV.ad.js

[MITM]
hostname = %APPEND% javdb.com, missav.live, missav.ws, missav.ai, missav.com
