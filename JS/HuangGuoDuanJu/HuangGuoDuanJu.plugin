[Rule]
URL-REGEX,^https?://[^/]*adsdk[12]\.cc,REJECT

[Script]
# > 黄果短剧去广告
http-response ^https?://huangguoai\.com script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/HuangGuoDuanJu/JS/HuangGuoDuanJu.js, requires-body=true, timeout=30, tag=黄果短剧

[MITM]
hostname = huangguoai.com, *.huangguoai.com, *.adsdk1.cc, *.adsdk2.cc
