[Script]
# > PikPak解锁会员
PikPak = type=http-response, pattern=^https:\/\/api-drive\.mypikpak\.com\/(vip\/v\d\/(vip\/info|allSubscriptionStatus)|drive\/v\d\/about\?space), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/PikPak/JS/PikPak.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api-drive.mypikpak.com
