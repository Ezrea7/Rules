#!name=WIS
#!desc=WIS 长期会员订阅.打开软件 > 设置 > 点击「恢复购买」
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=XiaoMao[https://github.com/xiaomaoJT/QxScript]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/WIS.png
#!openUrl=https://apps.apple.com/app/id1634630959

[Script]
# > WIS 长期会员订阅
WIS = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/WIS/JS/WIS.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
