[Script]
# > 京东比价
http-response ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/JD_Price/JS/JD_Price.js, requires-body=true, timeout=60, tag=京东比价

[MITM]
hostname = in.m.jd.com
