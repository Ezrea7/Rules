[Script]
# > Prisma-解锁VIP
Prisma解锁VIP = type=http-response, pattern=https://api.neuralprisma.com/receipt/ios, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Prisma/JS/Prisma.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.neuralprisma.com

