[Script]
# > Unfold视频照片编辑器-解锁订阅
http-response ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Unfold/JS/Unfold.js, requires-body=true, timeout=60, tag=Unfold
http-request ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Unfold/JS/Unfold.js, timeout=60, tag=Unfold

[MITM]
hostname = api.revenuecat.com
