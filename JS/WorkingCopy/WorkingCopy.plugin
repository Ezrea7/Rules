[Script]
# > WorkingCopy 解锁Pro
http-response ^https?:\/\/education\.github\.com\/api\/user$ script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/WorkingCopy/JS/WorkingCopy.js, requires-body=true, timeout=60, tag=WorkingCopy 解锁Pro

[MITM]
hostname = education.github.com
