[Script]
# > Pixelmator Photo+解锁订阅
Pixelmator = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Pixelmator/JS/Pixelmator.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
