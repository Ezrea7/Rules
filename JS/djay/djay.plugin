[Script]
# > djay解锁订阅
http-response ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/djay/JS/djay.js, requires-body=true, timeout=60, tag=djay解锁订阅
http-request ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/djay/JS/djay.js, timeout=60, tag=djay解锁订阅

[MITM]
hostname = api.revenuecat.com
