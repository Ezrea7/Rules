[Script]
# > djay解锁订阅
djay解锁订阅 = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/djay/JS/djay.js, requires-body=true, max-size=-1, timeout=60
djay解锁订阅 = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/djay/JS/djay.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
