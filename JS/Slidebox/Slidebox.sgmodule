[Script]
# > Slidebox解锁Pro
Slidebox = type=http-response, pattern=^https?:\/\/.*-slidebox-ios-prod\.cloudfunctions\.net\/api_v1, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Slidebox/JS/Slidebox.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *-slidebox-ios-prod.cloudfunctions.net
