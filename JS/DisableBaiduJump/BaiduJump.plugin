#!name=解决Safari中疯狂跳转百度
#!desc=解决Safari中疯狂跳转百度
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=浥轻尘yqc007[https://github.com/yqc007/QuantumultX]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/Baidu.png
#!openUrl = www.baidu.com

[Script]
# > 百度不跳转
http-request ^https?:\/\/.*\.baidu\.com\/.+ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/DisableBaiduJump/JS/DisableBaiduJumpAction.js, timeout=60, tag=DisableBaiduJumpAction

[MITM]
hostname = *.baidu.com
