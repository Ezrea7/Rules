[Script]
# > VFeed-解锁VIP
VFeed解锁VIP = type=http-response, pattern=https://api.apphud.com/v1/(subscriptions|customers), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/VFeed/JS/VFeed.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.apphud.com

