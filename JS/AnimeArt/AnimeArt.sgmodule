[Script]
# > Anime Waifu-AI画画解锁订阅
AnimeArt = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/AnimeArt/JS/AnimeArt.js, requires-body=true, max-size=-1, timeout=60
AnimeArt = type=http-request, pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/AnimeArt/JS/AnimeArt.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
