#!name=VDIT
#!desc=VDIT 年度会员订阅.打开软件 > 自动解锁
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=XiaoMao[https://github.com/xiaomaoJT/QxScript]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/VDIT.png
#!openUrl=https://apps.apple.com/app/id1483410865

[Script]
# > VDIT 年度会员订阅
VDIT = type=http-response, pattern=https:\/\/buy\.itunes\.apple\.com\/verifyReceipt, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/VDIT/JS/VDIT.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% buy.itunes.apple.com
