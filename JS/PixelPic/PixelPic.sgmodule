#!name=PixelPic
#!desc=PixelPic解锁Pro.打开软件 > 左上角Pro > 点击「恢复购买」
#!date=2026-01-21
#!category=🐹 BOBO Premium
#!author=XiaoMao[https://github.com/xiaomaoJT/QxScript]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/PixelPic.png
#!openUrl=https://apps.apple.com/app/id6504798523

[Script]
# > PixelPic解锁Pro
PixelPic = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/PixelPic/JS/PixelPic.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
