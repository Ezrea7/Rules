[Script]
# > Teak浏览器-解锁订阅
http-response ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Teak/JS/Teak.js, requires-body=true, timeout=60, tag=Teak
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Teak/JS/Teak.js, timeout=60, tag=Teak

[MITM]
hostname = api.revenuecat.com
