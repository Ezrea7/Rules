[Script]
# > TVOE-解锁VIP
TVOE解锁VIP = type=http-response, pattern=https:\/\/api\.tvoe\.live\/profile$, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/TVOE/JS/TVOE.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.tvoe.live

