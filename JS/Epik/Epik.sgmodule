[Script]
# > Epik解锁Pro
Epik解锁Pro = type=http-response, pattern=^https?:\/\/.*\.snow\.me\/v\d\/purchase\/subscription\/subscriber\/status, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Epik/JS/Epik.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.snow.me
