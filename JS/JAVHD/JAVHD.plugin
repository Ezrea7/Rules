http-response ^https?:\/\/(www\.|zh\.)?javhd\.com\/zh\/japanese-porn-videos\/category\/.+ script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js, requires-body=true, timeout=20, tag=JAVHD分类
http-response ^https?:\/\/(www\.|zh\.)?javhd\.com\/api\/.* script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js, requires-body=true, timeout=20, tag=JAVHD API
