[Script]
# > JAVHD视频解锁
http-response ^https?:\/\/(www\.|zh\.)?javhd\.com\/.*player_api script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js, requires-body=true, timeout=20, tag=JAVHD播放
