[Script]
# > JAVHD视频解锁
JAVHD播放 = type=http-response, pattern="^https?:\/\/(www\.|zh\.)?javhd\.com\/.*player_api", requires-body=1, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js
JAVHD页面 = type=http-response, pattern="^https?:\/\/(www\.|zh\.)?javhd\.com\/(zh\/studio\/room\/[\w-]+\/video\/[\w-]+|zh\/sex-categories|zh\/japanese-porn-videos|zh\/sex-videos|zh\/studio\/room|zh\/?$)", requires-body=1, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js
JAVHD分类 = type=http-response, pattern="^https?:\/\/(www\.|zh\.)?javhd\.com\/zh\/japanese-porn-videos\/category\/.+", requires-body=1, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js
JAVHD API = type=http-response, pattern="^https?:\/\/(www\.|zh\.)?javhd\.com\/api\/.*", requires-body=1, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js
JAVHD m3u8 = type=http-response, pattern="^https?:\/\/.*\.cdnjhd\.com\/.*\.m3u8(\?.*)?$", requires-body=1, max-size=-1, timeout=20, script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/JAVHD/JS/JAVHD.js

