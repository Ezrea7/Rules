http-response ^http?:\/\/musicpay\.kuwo\.cn\/music\.pay\?newver=3 script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/KuWoMusic/JS/JS-4/KuWoPE.js, requires-body=true, timeout=60, tag=下载
http-request ^http?:\/\/nmobi\.kuwo\.cn\/mobi\.s\?f=kuwo&q= script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/KuWoMusic/JS/JS-4/KuWoPE.js, requires-body=true, timeout=60, tag=播放

[MITM]
hostname = *.kuwo.cn
