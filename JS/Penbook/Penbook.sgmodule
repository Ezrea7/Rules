[Script]
# > Penbook解锁pro
Penbook解锁pro = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Penbook/JS/Penbook.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
