#!openUrl=https://apps.apple.com/app/id6480924989

[Script]
# > MemoKit 解锁Pro
MemoKit = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/MemoKit/JS/MemoKit.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
