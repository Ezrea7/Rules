#!name=SparkMail邮箱管理
#!desc=SparkMail邮箱管理-解锁订阅
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=枫叶afengye[https://github.com/afengye/QX]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/SparkMail.png
#!openUrl=https://apps.apple.com/app/id997102246

[Script]
# > SparkMail邮箱管理
SparkMail = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/SparkMail/JS/SparkMail.js, requires-body=true, max-size=-1, timeout=60
SparkMail = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/SparkMail/JS/SparkMail.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
