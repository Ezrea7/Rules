[Script]
# > AppRaven解锁会员
AppRaven = type=http-response, pattern=https://appraven.net/appraven/graphql, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/AppRaven/JS/JS-1/AppRavenPro.js, requires-body=true, max-size=-1, timeout=60

[MitM]
hostname = %APPEND% appraven.net
