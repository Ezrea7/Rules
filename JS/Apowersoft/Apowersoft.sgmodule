[Script]
# > 傲软系列解锁会员-登陆后解锁
傲软系列解锁会员 = type=http-response, pattern=^https?:\/\/.*\.(aoscdn\.com|apsapp\.cn), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Apowersoft/JS/Apowersoft.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.aoscdn.com, *.apsapp.cn
