[Script]
# > PixImagine lifetime解锁
PixImagine = type=http-response, pattern=https:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts), script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/PixImagine/JS/PixImagine.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
