[Script]
# > MIX2 解锁会员
MIX2 = type=http-response, pattern=https:\/\/bmall\.camera360\.com\/api\/iap\/check-receipt, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/MIX2/JS/MIX2.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% bmall.camera360.com
