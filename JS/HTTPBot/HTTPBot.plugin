[Script]
# > Httpbot解锁永久订阅,进软件恢复购买
http-request ^https?:\/\/api\.revenuecat\.com/v\d/(subscribers/(\$RCAnonymousID\%)?(\w)+|receipts)$ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/HTTPBot/JS/Httpbot.js, timeout=60, tag=Httpbot

[MITM]
hostname = api.revenuecat.com
