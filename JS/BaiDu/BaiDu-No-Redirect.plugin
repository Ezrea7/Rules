#!name=百度搜索防跳转AppStore
#!desc=使用网页版百度搜索,在搜索结果中点击关键词时防跳转AppStore
#!date=2026-01-21
#!category=🐹 Ezrea7 Premium
#!author=app2smile[https://github.com/app2smile]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/Baidu.png
#!openUrl=www.baidu.com

[Script]
# > 百度搜索防跳转AppStore
http-response ^https:\/\/boxer\.baidu\.com\/scheme\?scheme script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/BaiDu/JS/BaiDu-No-Redirect.js, timeout=10, tag=百度防跳转

[MITM]
hostname = boxer.baidu.com
