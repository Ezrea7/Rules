[Script]
# > Lake涂色书-解锁订阅
Lake = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Lake/JS/Lake.js, requires-body=true, max-size=-1, timeout=60
Lake = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Lake/JS/Lake.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
