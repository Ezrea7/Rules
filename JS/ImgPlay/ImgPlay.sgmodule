[Script]
# > ImgPlay gif制作器 & 表情包制作 & 动图  年度会员订阅
ImgPlay = type=http-response, pattern=https:\/\/buy\.itunes\.apple\.com\/verifyReceipt, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/ImgPlay/JS/ImgPlay.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% buy.itunes.apple.com
