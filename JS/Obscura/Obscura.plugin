[Script]
# > Obscura专业相机-解锁订阅
http-response ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Obscura/JS/Obscura.js, requires-body=true, timeout=60, tag=Obscura
http-request ^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$) script-path=https://raw.githubusercontent.com/Ezrea7/Rules/main/JS/Obscura/JS/Obscura.js, timeout=60, tag=Obscura

[MITM]
hostname = api.revenuecat.com
