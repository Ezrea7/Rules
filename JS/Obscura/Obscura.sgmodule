[Script]
# > Obscura专业相机-解锁订阅
Obscura = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Obscura/JS/Obscura.js, requires-body=true, max-size=-1, timeout=60
Obscura = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/.+$), script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/JS/Obscura/JS/Obscura.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
