#!openUrl=https://www.52pojie.cn/
#!arguments=禁用MITM:hostname
#!arguments-desc=禁用MITM：禁用MITM主机名，默认 hostname 表示启用，输入 # 表示禁用。\n\n获取Cookie说明：手动登录 https://www.52pojie.cn/home.php 如通知成功获取cookie, 则可以使用此签到脚本。\n\n此脚本获取Cookie会多次触发，导致Surge崩溃设备发热。获取一次Cookie后关闭MITM即可。

[Script]
吾爱破解获取Cookie = type=http-request,pattern=^https:\/\/www\.52pojie\.cn\/home\.php\?, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/52PoJie/JS/52pojie.js

吾爱破解签到 = type=cron,cronexp=0 9 * * *,wake-system=1,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/52PoJie/JS/52pojie.js,timeout=60

[MITM]
{{{禁用MITM}}} = %APPEND% www.52pojie.cn
