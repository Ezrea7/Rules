#!name=吾爱破解签到
#!desc=吾爱破解签到,可在BoxJS中做更详细的设置。\n获取Cookie说明：手动登录 https://www.52pojie.cn/home.php 如通知成功获取cookie, 则可以使用此签到脚本。\n此脚本获取Cookie会多次触发，导致Loon崩溃设备发热。获取一次Cookie后关闭脚本即可。
#!date=2026-01-25
#!category=🐹 Ezrea7 Task
#!author=桂林仔Yuheng0101[https://github.com/Yuheng0101/X]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/miniColor/Image/Color/52pj.png
#!openUrl=https://www.52pojie.cn/

[Argument]
获取Cookie = switch, ture, tag = [启用]获取Cookie, desc = 关闭开关将不对此选项生效

[Script]
http-request ^https:\/\/www\.52pojie\.cn\/home\.php\? tag=吾爱破解获取Cookie, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/52PoJie/JS/52pojie.js, enable={获取Cookie}

cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/52PoJie/JS/52pojie.js, timeout=10, tag=吾爱破解签到

[MITM]
hostname = www.52pojie.cn
