#!name=Macat签到任务
#!desc=自动执行Macat每日签到任务。macat_loginBody" (boxjs自行填入,包含账号密码信息等)格式: `action=user_login&username=xxx%40gmail.com&password=xxx&rememberme=1`
#!date=2025-12-23
#!category=🐹 Ezrea7 Task
#!author= MCdasheng[https://github.com/MCdasheng]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/miniColor/Image/Color/Skicat.png
#!openUrl=https://www.macat.vip
#!arguments=签到任务时间:0 8 * * *, 启用签到任务:true
#!arguments-desc=\n★参数说明:\n\n - 签到任务时间: Cron 表达式（默认每天上午8点）\n\n - 启用签到任务: 是否启用定时签到逻辑\n\n\n★提示:\n\n - 格式 `action=user_login&username=xxx%40gmail.com&password=xxx&rememberme=1`。请替换为实际账号密码信息\n - Cron 示例：每天8点 → `0 8 * * *`；每周一12点 → `0 12 * * 1`

[Script]
# ===== 定时签到任务 =====
Macat签到 = type=cron, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/Macat/JS/Macat.js, cronexpr={{{签到任务时间}}}, timeout=60, script-update-interval=0, enable={{{启用签到任务}}}

[MITM]
hostname = %APPEND% www.macat.vip

