#!name=酷我音乐签到助手
#!desc=酷我音乐自动签到、领金币、抽奖等任务。\n手机号: 酷我登录手机号，用于面板自动填充 \nOCR密钥: 填写 ocr.space 的 API Key (留空则不用) \n\n安装插件&模块,编辑模块&插件填写参数，然后打开 https://360.com/kuwo ，然后获取图片二维码，然后发送和填写验证码后登录 \n\n首次会自动完成一次任务，后续缓存ck 定时运行 \n\n定时任务：每天从早上 7 点到晚上 11 点之间，每小时的第 15 分钟执行一次，可自行更改 \n\n注意事项：如果用不上不用填ocr，脚本可以通过接入 ocr.space 的 OCR API 来识别验证码图片。
#!date=2026-01-21
#!category=🐹 Ezrea7 Task
#!author= baby[https://github.com/Yu9191]
#!icon=https://raw.githubusercontent.com/Ezrea7/Script/main/Icons/AppIcons/Image/App/KuWoSVIP.png
#!openUrl=https://360.com/kuwo

[Argument]
phone = input,"",tag=手机号,desc=用于Web登录的手机号(可留空)
ocr = input,"",tag=OCR密钥,desc=验证码识别API密钥(可留空)
notify = switch,true,tag=每次通知,desc=关闭后仅在23点发送汇总通知

[Script]
# > 酷我音乐签到助手
cron "15 7-23/1 * * *" script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/KuWoTask/JS/JS-1/KuWoTask.js, timeout=120, tag=酷我音乐签到, argument=[{phone},{ocr},{notify}]

http-request ^https?:\/\/360\.com\/kuwo script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Task/KuWoTask/JS/JS-1/KuWoTask.js, requires-body=true, timeout=60, tag=酷我助手面板, argument=[{phone},{ocr},{notify}]

[MITM]
hostname = 360.com
