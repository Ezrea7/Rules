          "val": 10,
          "desc": "面板刷新周期；入口定位缓存 TTL=min(Update,3600)"
        },
        {
          "id": "@Panel.NetworkInfo.Settings.Timeout",
          "name": "脚本超时（秒）",
          "type": "number",
          "val": 14,
          "desc": "建议 ≥ 10；脚本内部仍会按预算 clamp 单次请求超时"
