#!name=NetISP入口落地查询
#!desc=查看目标节点ISP（网络服务提供商）的入口落地详细信息-可自定义隐藏IP段/超时
#!date=2026-01-21
#!category=🐹 BOBO面板模块
#!author= Keywos[https://github.com/Keywos/rule],xream[https://github.com/xream/scripts]
#!arguments= script-update:-1 ,icons:globe.asia.australia, icolor:#6699FF, GPT:0 ,HideIP:1, cnTimeout:1000, usTimeout:3000
#!arguments-desc= 入口查询超时: cnTimeout\n落地查询超时: usTimeout\n隐藏IP: HideIP \n\n开启为: 1\n关闭为: 0

[Panel]
NetISP = script-name=NetISP,update-interval=-1

[Script]
NetISP = type=generic,timeout=8,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/NetISP/JS/Surge.js, script-update-interval={{{script-update}}},argument=icolor={{{icolor}}}&icon={{{icons}}}&GPT={{{GPT}}}&hideIP={{{HideIP}}}&cnTimeout={{{cnTimeout}}}&usTimeout={{{usTimeout}}}
