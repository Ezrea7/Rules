[Panel]
netflixCheck = script-name=netflixCheck,update-interval=1, 

[Script]
netflixCheck = type=generic,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/Netflix/JS/Netflix-IP-Test.js, timeout=30, argument=icon1=checkmark.shield&color1=#1B813E&icon2=exclamationmark.shield&color2=#EFBB24&icon3=xmark.shield&color3=#CB1B45&icon4=exclamationmark.arrow.triangle.2.circlepath&color4=#77428D&title=Netflix 影劇版權 IP 鎖測試
