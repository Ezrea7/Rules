[Script]
NT二进制模式 = type=http-request, pattern=^https?:\/\/neteasems\.test\/binary, requires-body=1, timeout=50, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/NetTest/JS/ntbm.js

加解密耗时 = type=http-request, pattern=^https?:\/\/neteasems\.test, requires-body=1, timeout=300, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/NetTest/JS/nt.js

[MITM]
hostname = %APPEND% neteasems.test
