#!name= Ping CN CF 二合一面板
#!desc= 根据网络延迟生成柱状图
#!date=2026-01-21
#!category=🐹 BOBO面板模块
#!author= Keywos[https://github.com/Keywos/rule]
#!arguments= script-update:-1 ,update-interval: 10, Size:7, cnUrl:"", usUrl:"",icons:barometer,icolor:#80A0BF
#!arguments-desc=脚本更新频率: script-update \nGIF更新频率: update-interval \n\n国内测试URL: cnUrl \n国外测试URL: usUrl \n\n如果一行放不下可自定义每行显示个数默认为 7: Size

[Panel]
ProPing = script-name=ProPing,update-interval={{{update-interval}}}

[Script]
ProPing = type=generic,timeout=6,script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/Ping/JS/Ping.js, script-update-interval={{{script-update}}},argument=Size={{{Size}}}&cnUrl={{{cnUrl}}}&usUrl={{{usUrl}}}&icons={{{icons}}}&icolor={{{icolor}}}
