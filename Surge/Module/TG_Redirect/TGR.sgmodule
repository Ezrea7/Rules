#!name = Telegram跳转
#!desc = 将 https://t.me/... 重定向到你选择的客户端（tg/sg/turrit/ime/ng/lingo
#!date=2025-12-21
#!category=🐹 BOBO Enhance
#!author= baby[https://github.com/Yu9191/Rewrite]
#!arguments = Client:"Telegram"
#!arguments-desc = Client: Telegram/Swiftgram/Turrit/iMe/Nicegram/Lingogram 或 tg/sg/turrit/ime/ng/lingo

[Script]
Tg跳转 = type=http-request, pattern=^https?:\/\/t\.me\/.+, requires-body=0, script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/TG_Redirect/JS/TGR.js, argument=client={{{Client}}}

[MITM]
hostname = %APPEND% t.me
