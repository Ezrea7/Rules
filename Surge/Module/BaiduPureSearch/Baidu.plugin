[Script]
http-response ^https?:\/\/(?:www|m)\.baidu\.com(?:\/|\/\?(tn=&)?from=\w+)?$ script-path=https://raw.githubusercontent.com/Ezrea7/Script/main/Surge/Module/BaiduPureSearch/JS/Loon.js, requires-body = true, tag = 百度首页

[MITM]
hostname = m.baidu.com, www.baidu.com
